 SG_ LOOP_MAX_MS : 55|8@0+ (1,0) [0|255] "ms" XXX
 SG_ CHECKSUM : 63|8@0+ (1,0) [0|255] "" XXX

CM_ "BO_ RETROFIT_STALK_DIAG: Retrofit cruise stalk ECU status, 2 Hz plus one frame right after boot and after a CAN recovery. Source: corolla_emulator/cruise_stalk.";
CM_ SG_ 1281 RESET_PHASE "Loop phase the watchdog caught the board in (only meaningful when RESET_KIND is WATCHDOG or DELIBERATE).";
VAL_ 1281 RESET_KIND 5 "DELIBERATE" 4 "WATCHDOG" 3 "EXTERNAL" 2 "BROWN_OUT" 1 "POWER_ON" 0 "UNKNOWN" ;
VAL_ 1281 RESET_PHASE 9 "LOOP" 8 "RECOVERY" 7 "SERIAL" 6 "HEALTH" 5 "CAN_TX" 4 "STALK" 3 "CAN_RX" 2 "CAN_INIT" 1 "SETUP" 0 "NONE" ;
VAL_ 1281 RECOVERY_REASON 3 "BUS_OFF" 2 "MODE_LOST" 1 "TX_STUCK" 0 "NONE" ;

